+    @staticmethod
+    def pico_button_choices(button):
+        '''
+        Mode carte Pico : valeurs proposées pour un élément du menu Boutons (include/cpico.py) :
+        BTN1 à BTN15 pour PIN_* (et MISS pour PIN_MISSDART), V1 à V12 pour LIGHT_*, T1 à T8 pour TOY*
+        '''
+        if button.startswith('LIGHT_'):
+            values = [f'V{number}' for number in range(1, 13)]
+        elif button.startswith('TOY'):
+            values = [f'T{number}' for number in range(1, 9)]
+        else:
+            values = [f'BTN{number}' for number in range(1, 16)] + (['MISS'] if button == 'PIN_MISSDART' else [])
+        return [('', 'notattributed')] + [(value, value) for value in values]
+
