+######## DARTSPICO-BRIDGE : CARTE PICO ######
+
+msgid "card-pico"
+msgstr "Pico card"
+
+msgid "pico-ring-204"
+msgstr "204 LEDs (no ring)"
+
+msgid "pico-ring-244-before"
+msgstr "244 LEDs, ring before the quarters"
+
+msgid "pico-ring-244-after"
+msgstr "244 LEDs, ring after the quarters"
+
+msgid "pico-ring-none"
+msgstr "None"
+
+msgid "pico-ring-question"
+msgstr "Target LEDs (channel 0)"
+
+msgid "pico-not-detected"
+msgstr "Pico card not detected ({device} missing): configuration written anyway"
+
+msgid "pico-absent"
+msgstr "No Pico card"
+
+msgid "pico-button-banned"
+msgstr "Button {button} (Pico card) is banned."
+
+msgid "pico-button-leds-sub"
+msgstr "The button LEDs connected to the Pico card"
+
+msgid "pico-no-coins"
+msgstr "No coin mechanism with the Pico card"
+
+msgid "pico-update-disabled"
+msgstr "Update disabled in Pico card mode"
