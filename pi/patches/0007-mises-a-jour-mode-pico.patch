From 50106c0b5271807c8767cb7a3c44d19accde60cb Mon Sep 17 00:00:00 2001
From: Gohy Yves <6154641+diogeneyves@users.noreply.github.com>
Date: Sun, 22 Nov 2026 08:03:20 +0100
Subject: [PATCH] Updates: disable them in Pico board mode
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

In Pico board mode ([SectionAdvanced] hardware = pico):
- cscreen.py: the "Vérifier les mises à jour" button in Settings shows
  "Mise à jour désactivée en mode carte Pico" (key pico-update-disabled, French
  default text, pico_text) and goes back to the menu, without asking GitHub;
- raspydarts.py: at start-up, no pending install (backup/update_pending.json),
  no check (check_for_updates), one log line;
- cdmdmenu.py: Raspy2DMD install, start, update and uninstall buttons hidden;
  selection kept when no command is left; the raspy2dmd-remote-unknown text
  and the version note (version_note: main screen and score sub-menu) hidden.
In normal mode, behaviour identical to the original.
---
 include/cdmdmenu.py | 35 +++++++++++++++++++++++++++++++++--
 include/cscreen.py  |  9 +++++++++
 raspydarts.py       | 14 ++++++++++++--
 3 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/include/cdmdmenu.py b/include/cdmdmenu.py
index 3f372b5..553d91d 100644
--- a/include/cdmdmenu.py
+++ b/include/cdmdmenu.py
@@ -24,6 +24,30 @@ def translate(screen, key):
     return screen.lang.translate(key)
 
 
+# Mode carte Pico (DartsPico-Bridge, patch 0007) : l'Interstate 75 W remplace Raspy2DMD ; ses
+# boutons d'installation (script téléchargé et lancé en root), de démarrage, de mise à jour et
+# de suppression sont masqués, comme (complément 89) le texte « Raspy2DMD n'est pas installé sur
+# la borne… » et la note de version (version_note). Le reste du menu ne change pas
+PICO_HIDDEN_COMMANDS = ('install', 'start', 'update', 'uninstall')
+
+
+def pico_mode(screen):
+    '''
+    Vrai en mode carte Pico ; faux en mode normal ou si l'écran ne connaît pas ce mode
+    '''
+    mode = getattr(screen, 'pico_mode', None)
+    return mode is not None and bool(mode())
+
+
+def pico_commands(screen, commands):
+    '''
+    Les commandes du menu : sans celles de PICO_HIDDEN_COMMANDS en mode carte Pico
+    '''
+    if not pico_mode(screen):
+        return commands
+    return [command for command in commands if command[0] not in PICO_HIDDEN_COMMANDS]
+
+
 def style_label(screen, value):
     return translate(screen, f'dmd-style-{value}')
 
@@ -98,6 +122,9 @@ def version_note(screen, style=None):
     What the styles need, when the Raspy2DMD is too old or not known (another Raspberry) : the
     styles of 1.6.2.3 (Moderne, Chasse aux canards), those of 1.6.2.4 (the others)
     '''
+    # Mode carte Pico : aucune note, tous les styles sont rendus en Classique (complément 89)
+    if pico_mode(screen):
+        return None
     newer = style is not None and cdmdscore.NEEDS.get(style, (0,)) > cdmdscore.NEEDED
     known = cdmdscore.style_known(style) if newer else cdmdscore.styles_known()
     if known is True:
@@ -149,6 +176,7 @@ def raspy2dmd_menu(screen, dispatcher):
                 commands.append(('uninstall', 'raspy2dmd-uninstall'))
         else:
             commands.append(('install', 'raspy2dmd-install-here'))
+        commands = pico_commands(screen, commands)
         # In the order of reading : the settings, the commands, Retour
         entries = [('setting',) + item for item in settings] + [('command',) + item + (None,) for item in commands] + [('back', 'back', 'back', None)]
         selected = max(0, min(selected, len(entries) - 1))
@@ -173,7 +201,8 @@ def raspy2dmd_menu(screen, dispatcher):
             for url in urls:
                 screen.blit_text(url, left.x, text_y, left.width, line, screen.colorset['menu-text-white'])
                 text_y += line
-        else:
+        elif not pico_mode(screen):
+            # Mode carte Pico : ce texte est masqué, rien à sa place (complément 89)
             cmenueditor.paragraph(screen, translate(screen, 'raspy2dmd-remote-unknown'),
                                   pygame.Rect(left.x, text_y, left.width, int(3 * unit_y)), screen.colorset['menu-text-white'])
             text_y += int(3 * unit_y)
@@ -234,7 +263,9 @@ def raspy2dmd_menu(screen, dispatcher):
         elif key in ('left', 'right', 'S11', 'S6'):
             if kind in ('setting', 'command'):
                 other = [index for index, entry in enumerate(entries) if entry[0] == ('command' if kind == 'setting' else 'setting')]
-                selected = other[min(same.index(selected), len(other) - 1)]
+                # Aucune commande (mode carte Pico, Raspy2DMD arrêté) : la sélection reste
+                if other:
+                    selected = other[min(same.index(selected), len(other) - 1)]
         elif key in ENTER_KEYS + ['space']:
             kind, ident = entries[selected][0], entries[selected][1]
             if kind == 'back':
diff --git a/include/cscreen.py b/include/cscreen.py
index 23e455b..39860f8 100644
--- a/include/cscreen.py
+++ b/include/cscreen.py
@@ -6572,6 +6572,15 @@ class Screen(pygame.Surface):
             if button.get('action') != 'update':
                 return menus.result(button)
 
+            if self.pico_mode():
+                # Mode carte Pico (DartsPico-Bridge, patch 0007) : une mise à jour écraserait les
+                # fichiers modifiés par les patchs ; aucune demande à GitHub
+                self.logs.info("Update : not checked in Pico card mode (patch 0007)")
+                self.update_screen(self.message([self.pico_text('pico-update-disabled',
+                                                                 'Mise à jour désactivée en mode carte Pico')],
+                                                2500, self.colorset['menu-ko'], 'middle', 'big'))
+                continue
+
             version = update[0].get_version(self.logs)
             try:
                 if self.update_mode() == 'ask':
diff --git a/raspydarts.py b/raspydarts.py
index 2d76f68..664c7db 100644
--- a/raspydarts.py
+++ b/raspydarts.py
@@ -415,7 +415,17 @@ def update_progress(key, unit=''):
 
 # An update downloaded in the background (Mise à jour prête : Demander) : installed now,
 # before the game loads anything, then the game started again
-pending_update = cupdate.load_pending(logs, version)
+# Mode carte Pico (DartsPico-Bridge, patch 0007) : ni installation en attente, ni vérification
+# (une mise à jour écraserait les fichiers modifiés par les patchs)
+from include import ci2c as ci2c_update
+pico_no_update = ci2c_update.pico_mode(Config)
+if pico_no_update:
+    logs.info("Update : pending installation and check skipped in Pico card mode (patch 0007)")
+    if os.path.isfile(cupdate.PENDING_FILE):
+        logs.warning(f"Pending update ignored in Pico card mode : {cupdate.PENDING_FILE}")
+    pending_update = None
+else:
+    pending_update = cupdate.load_pending(logs, version)
 if pending_update is not None:
     display.message(['updating'], 0, None, 'middle')
     new_version = cupdate.apply_update(logs, pending_update, update_progress('updating'))
@@ -428,7 +438,7 @@ if pending_update is not None:
         version = new_version
         game_type = 'restart'
         logs.info("Update waiting : done")
-elif Config.get_value('SectionGlobals', 'check_for_updates', False):
+elif not pico_no_update and Config.get_value('SectionGlobals', 'check_for_updates', False):
     try:
         display.message(['update-check'], 0, None, 'middle')
         update = cupdate.get_last(logs, version)
