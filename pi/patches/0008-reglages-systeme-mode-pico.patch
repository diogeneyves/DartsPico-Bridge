From aa349dd8016552d4761a40069699623e68833b93 Mon Sep 17 00:00:00 2001
From: Gohy Yves <6154641+diogeneyves@users.noreply.github.com>
Date: Sun, 22 Nov 2026 10:55:31 +0100
Subject: [PATCH] System settings: skip them in Pico board mode

In Pico board mode ([SectionAdvanced] hardware = pico), raspydarts.py does not
call cupdate.apply_system_settings: neither on a version change nor on a doubled
MQTT listener is scripts/reglages_systeme.sh run (it would open mosquitto to the
network without a password and restart it). One log line.
In normal mode, behaviour identical to the original.
---
 raspydarts.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/raspydarts.py b/raspydarts.py
index 664c7db..e214cc2 100644
--- a/raspydarts.py
+++ b/raspydarts.py
@@ -390,7 +390,13 @@ version = cupdate.get_version(logs)
 # Statistiques de partie : envoyées ou non selon [SectionAdvanced] send-stats (DartsPico-Bridge)
 cupdate.set_send_stats(config_advanced.get('send-stats', True))
 # After an update (the game restarted) : the settings of the system of the new version
-cupdate.apply_system_settings(logs, version)
+# Mode carte Pico (DartsPico-Bridge, patch 0008) : jamais appliqués (scripts/reglages_systeme.sh
+# ouvrirait mosquitto au réseau et le relancerait, coupant la liaison de hwd)
+from include import ci2c as ci2c_settings
+if ci2c_settings.pico_mode(Config):
+    logs.info("System settings : not applied in Pico card mode (patch 0008)")
+else:
+    cupdate.apply_system_settings(logs, version)
 # The page Paramétrage of the themes still as delivered : 4 columns, with LED des boutons
 from include import cmenus as cmenus_migration
 cmenus_migration.migrate_settings_page(logs, os.path.join(cpaths.user_dir(), 'themes'))
