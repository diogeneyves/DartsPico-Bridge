# DartsPico-Bridge : démon matériel hwd (spécification § 9.5 et § 9.9, 50e complément).
# Installé par tools/install_services.sh dans /etc/systemd/system/, sans être activé.
# User et Group : marqueurs remplis à l'installation par pi/systemd/fill_units.sh (--user,
# groupe principal de cet utilisateur lu sur le Pi, complément 77).
# Ne jamais le faire tourner en même temps qu'un hwd lancé à la main (start_hwd.sh, par
# exemple : un seul propriétaire des ports /dev/cible et /dev/dmd, D10).
[Unit]
Description=DartsPico-Bridge : démon matériel hwd (carte Pico et DMD)
After=mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=@RASPYDARTS_USER@
Group=@RASPYDARTS_GROUP@
SupplementaryGroups=dialout
WorkingDirectory=/opt/dartspico-bridge
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/dartspico-bridge/pi/hwd/hwd_daemon.py --config /etc/raspydarts/hwd.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
