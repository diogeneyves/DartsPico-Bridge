+    # Lien udev vers le port USB de la carte Pico (spécification § 2)
+    PICO_DEVICE = '/dev/cible'
+    # Tables de l'anneau de la cible (canal 0), par la position du pneu (set_dartcab_leds_config) :
+    # sans pneu, DartcabLedsNoTire (204 LED, kit RaspyLed) ; avant les quarts, JiLedsConfig ; après,
+    # DartcabLedsTireAfter (244 LED)
+    # [valeur enregistrée, clé de traduction, texte français par défaut]
+    PICO_RINGS = [['none', 'pico-ring-204', 'Anneau 204 LED (sans pneu)'],
+                  ['before', 'pico-ring-244-before', '244 LED, pneu avant les quarts'],
+                  ['after', 'pico-ring-244-after', '244 LED, pneu après'],
+                  ['no', 'pico-ring-none', 'Aucune']]
+
+    def wizard_pico_card(self):
+        '''
+        Assistant, carte Pico : la cible, les boutons, les Toys et les voyants sont sur la carte
+        (préréglage set_pico_card_config) ; ni broche à demander, ni étalonnage ici (demandé au
+        démarrage suivant, calibration_needed), ni carte d'extension (setup_io_extender).
+        LED : canaux fixes, cible 0 et ruban 1 ; table de l'anneau de la cible (canal 0, [LEDTarget])
+        choisie dans une liste (set_dartcab_leds_config : 204 LED sans pneu par défaut, 244 LED
+        avec pneu avant ou après les quarts), ou aucune. La carte absente (pas de /dev/cible) :
+        avertissement, sans blocage
+        '''
+        if not os.path.exists(self.PICO_DEVICE):
+            self.message([self.pico_text('pico-not-detected',
+                                         'Carte Pico non détectée ({device} absent) : configuration écrite quand même')
+                          .replace('{device}', self.PICO_DEVICE)],
+                         3000, None, 'middle', 'big')
+        self.config.set_pico_card_config()
+
+        self.display_background()    # display basic screen
+        self.menu_header("config-leds_choice", self.pico_text('pico-ring-question', 'Anneau de LED de la cible (canal 0)'))
+        self.update_screen()
+        rings = [[value, self.pico_text(key, default)] for value, key, default in self.PICO_RINGS]
+        ring = self.dropdown(6 * self.res_x_16, 3 * self.res_y_16, rings)
+        if ring == 'escape':
+            ring = 'none'
+
+        new_leds = self.wizard_pico_leds()
+        if new_leds is None:
+            return False
+        self.rpi.set_leds_conf(new_leds)
+        if ring in ('none', 'before', 'after'):
+            self.config.set_dartcab_leds_config(ring)
+
+        # Write config file
+        self.config.write_file()
+
+        self.message([f"{self.lang.translate('config-restart')}"], 2500, None, 'middle', 'big')
+        return True
+
+    def wizard_pico_leds(self):
+        '''
+        LED de la carte Pico : canal 0 (cible) et canal 1 (ruban), fixes. Cible : luminosité et
+        ordre des couleurs (son nombre de LED vient de [LEDTarget]) ; ruban : nombre (0 : pas de
+        ruban, ses autres étapes sautées), luminosité, ordre. Échap : l'étape d'avant ; sur la
+        première, None (assistant quitté)
+        '''
+        new_leds = {'PIN_TARGETLED': '0', 'PIN_STRIPLED': '1'}
+        keys = ['BRI_TARGETLED', 'TYP_TARGETLED', 'NBR_STRIPLED', 'BRI_STRIPLED', 'TYP_STRIPLED']
+        history = []
+        j = 0
+        while j < len(keys):
+            key = keys[j]
+            esc_text = self.lang.translate('conf-esc1' if not history else 'conf-esc2')
+            self.display_background()    # display basic screen
+            self.menu_header(self.lang.translate('conf-leds'))
+            self.message([f"{self.lang.translate('conf-fillin')} {self.lang.translate(key)}"], 0, None, 'fullbottom', 'big', refresh=False)
+            self.update_screen()
+
+            if key.startswith('TYP_'):
+                tmp = self.dropdown(self.res['x'] * 6 / 16, 3 * self.res_y_16, [['rgb', 'RGB'], ['grb', 'GRB']])
+            elif key == 'NBR_STRIPLED':
+                tmp = self.input_value_item('number', '', 0, 300, align='Center')
+            else:
+                tmp = self.input_value_item('number', '', 1, 100, align='Center')
+
+            if tmp == 'escape':
+                if not history:
+                    return None
+                j = history.pop()
+                new_leds.pop(keys[j], None)
+                continue
+            if key == 'NBR_STRIPLED':
+                if tmp in ('', 'space', '0'):
+                    # No strip
+                    new_leds.update({'NBR_STRIPLED': 0, 'BRI_STRIPLED': 0, 'TYP_STRIPLED': 'grb'})
+                    history.append(j)
+                    j = len(keys)
+                    continue
+                if not str(tmp).isdigit() or int(tmp) > 300:
+                    # 300 LED at most on a channel : asked again
+                    continue
+            elif tmp in ('', 'space'):
+                # A value is needed : asked again
+                continue
+            new_leds[key] = tmp
+            history.append(j)
+            j += 1
+        return new_leds
+
